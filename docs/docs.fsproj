<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <IsPackable>false</IsPackable>
    <FSharpCoreImplicitPackageVersion>11.0.101-rc1.26425.128</FSharpCoreImplicitPackageVersion>
  </PropertyGroup>
  <ItemGroup>
    <Compile Include="HomepageStyles.fs" />
    <Compile Include="Styles.fs" />
    <Compile Include="Theme.fs" />
    <Compile Include="Site.fs" />
  </ItemGroup>
  <ItemGroup>
    <PackageReference Include="Nacara.Core" Version="2.0.0-beta.6" />
    <PackageReference Include="Nacara.Plugin.Markdown" Version="1.0.0-beta.2" />
    <PackageReference Include="Nacara.Plugin.LinkValidator" Version="1.0.0-beta.2" />
    <PackageReference Include="Nacara.Plugin.Highlight.TextMate" Version="1.0.0-beta.1" />
    <PackageReference Include="Nacara.Plugin.Sitemap" Version="1.0.0-beta.1" />
    <PackageReference Include="Partas.Nacara.Plugins.AgentFriendly" Version="0.1.0" />
    <PackageReference Include="Ranvier.Css" Version="0.3.0" />
    <PackageReference Include="Ranvier.View" Version="0.4.0" />
  </ItemGroup>
</Project>
