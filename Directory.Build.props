<Project>
  <PropertyGroup>
    <TargetFramework>net10.0</TargetFramework>
    <LangVersion>latest</LangVersion>
    <TreatWarningsAsErrors>true</TreatWarningsAsErrors>
    <FSharpCoreImplicitPackageVersion>9.0.100</FSharpCoreImplicitPackageVersion>
    <NuGetAudit>false</NuGetAudit>
    <Version>0.1.3</Version>
    <RanvierTrace Condition="'$(RanvierTrace)' == ''">false</RanvierTrace>
    <RanvierPackageSuffix Condition="'$(RanvierTrace)' == 'true'">.Traced</RanvierPackageSuffix>
    <DefineConstants Condition="'$(RanvierTrace)' == 'true'">$(DefineConstants);RANVIER_TRACE</DefineConstants>
  </PropertyGroup>
</Project>
